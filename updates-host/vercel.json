{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/latest-mac.yml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/latest.yml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*).exe",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*).zip",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*).blockmap",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/Drip-Type-1.7.0-mac.dmg",
      "destination": "https://github.com/Salt30/drip-type-releases/releases/download/v1.7.0/Drip-Type-1.7.0-mac.dmg",
      "permanent": false
    },
    {
      "source": "/Drip-Type-1.7.0-mac.dmg.blockmap",
      "destination": "https://github.com/Salt30/drip-type-releases/releases/download/v1.7.0/Drip-Type-1.7.0-mac.dmg.blockmap",
      "permanent": false
    },
    {
      "source": "/Drip-Type-1.7.0-mac.zip",
      "destination": "https://github.com/Salt30/drip-type-releases/releases/download/v1.7.0/Drip-Type-1.7.0-mac.zip",
      "permanent": false
    },
    {
      "source": "/Drip-Type-1.7.0-mac.zip.blockmap",
      "destination": "https://github.com/Salt30/drip-type-releases/releases/download/v1.7.0/Drip-Type-1.7.0-mac.zip.blockmap",
      "permanent": false
    },
    {
      "source": "/Drip-Type-1.7.0-windows.exe",
      "destination": "https://github.com/Salt30/drip-type-releases/releases/download/v1.7.0/Drip-Type-1.7.0-windows.exe",
      "permanent": false
    },
    {
      "source": "/Drip-Type-1.7.0-windows.exe.blockmap",
      "destination": "https://github.com/Salt30/drip-type-releases/releases/download/v1.7.0/Drip-Type-1.7.0-windows.exe.blockmap",
      "permanent": false
    }
  ]
}
