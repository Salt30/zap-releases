{
  "name": "zap-launcher",
  "version": "1.0.0",
  "description": "Zap Pro Launcher",
  "main": "src/launcher.js",
  "author": {
    "name": "Zap",
    "email": "noreply@tryzap.net"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Salt30/zap-releases.git"
  },
  "license": "MIT",
  "build": {
    "publish": null,
    "appId": "com.zap.launcher",
    "productName": "Zap Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "../assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "../build/entitlements.mac.plist",
      "entitlementsInherit": "../build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true,
        "NSScreenCaptureDescription": "Zap needs screen recording access to capture and analyze content on your screen.",
        "NSAppleEventsUsageDescription": "Zap needs accessibility access for the Drip Type feature to type text into other applications."
      }
    },
    "win": {
      "icon": "../assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "icon": "../assets/icon.png",
      "iconSize": 128,
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ],
      "window": { "width": 540, "height": 380 }
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  }
}
