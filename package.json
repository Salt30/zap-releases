{
  "name": "drip-type",
  "version": "1.5.0",
  "description": "Natural, configurable typing for macOS.",
  "main": "src/main.js",
  "author": "VegaNext LLC",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:app": "node scripts/build-app.js",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/index.js && node --check src/quick.js && node --check src/text-tools.js && node --check src/subscription.js && node --check src/onboarding.js && node --check scripts/build-app.js && node --check scripts/after-pack.js && node --check scripts/publish-update-blobs.js && node --check scripts/verify-source.js && node --check scripts/verify-package.js",
    "test:source": "node scripts/verify-source.js",
    "verify": "npm run check && npm run test:source && npm run build:app",
    "verify:package": "node scripts/verify-package.js",
    "pack:mac": "npm run build:app && electron-builder --mac --dir --universal -c.mac.forceCodeSigning=false",
    "dist:mac": "npm run build:app && electron-builder --mac dmg zip --universal --publish never",
    "release:mac": "bash scripts/release-mac.sh"
  },
  "keywords": [
    "electron",
    "typing",
    "macos",
    "accessibility",
    "productivity"
  ],
  "dependencies": {
    "electron-store": "8.2.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@vercel/blob": "2.8.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12"
  },
  "build": {
    "appId": "com.salt30.driptype",
    "productName": "Drip Type",
    "artifactName": "Drip-Type-${version}-mac.${ext}",
    "asar": true,
    "compression": "maximum",
    "extraMetadata": {
      "main": "build-app/main.js"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "build-app/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "electronLanguages": ["en"],
    "afterPack": "scripts/after-pack.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://drip-type-updates.vercel.app/"
      }
    ],
    "releaseInfo": {
      "releaseName": "Drip Type 1.5.0",
      "releaseNotes": "Start with a 14-day Core trial, activate a paid subscription from Stripe Checkout, view access in the native Billing page, and manage billing securely. Activation is device-bound, verified with signed entitlements, and protected by macOS Keychain. Composer content remains local."
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Drip Type activation",
            "CFBundleURLSchemes": ["driptype"]
          }
        ],
        "LSApplicationCategoryType": "public.app-category.productivity",
        "NSAppleEventsUsageDescription": "Drip Type uses macOS System Events to type text into the application you choose.",
        "NSAccessibilityUsageDescription": "Drip Type needs Accessibility access to type text into other applications."
      }
    },
    "dmg": {
      "title": "Drip Type ${version}",
      "icon": "assets/icon.png",
      "backgroundColor": "#0d0f13",
      "iconSize": 128,
      "window": { "width": 540, "height": 380 },
      "contents": [
        { "x": 140, "y": 185 },
        { "x": 400, "y": 185, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
