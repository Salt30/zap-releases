{
  "name": "zap",
  "version": "3.37.1",
  "description": "Zap \u2014 AI Screen Overlay",
  "main": "src/main.js",
  "author": {
    "name": "Zap",
    "email": "noreply@tryzap.net"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "dist": "electron-builder --mac dmg zip"
  },
  "build": {
    "appId": "com.zap.app",
    "productName": "Zap Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/node_modules/**/.git",
      "!**/node_modules/**/test",
      "!**/node_modules/**/tests"
    ],
    "extraResources": [
      {
        "from": "helpers/bin/",
        "to": "helpers",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist/shield/",
        "to": ".",
        "filter": [
          "zap_shield.dll",
          "zap_overlay.dll"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "stripe": "^20.3.1",
    "tweetnacl": "^1.0.3"
  },
  "optionalDependencies": {
    "ffi-napi": "^4.0.3",
    "ref-napi": "^3.0.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/osx-sign": "^2.3.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  }
}